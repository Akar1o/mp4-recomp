#!/bin/sh
# Metroid Prime 4 Beyond AppImage: the game is installed outside the (read-only) AppImage, in METROID_BEYOND_HOME or
# ~/.local/share/MetroidBeyondRecomp. The runtime finds its .ini, _code.so and _data next to itself, so a copy of it lives
# there, refreshed when this AppImage brings a different one. The Play / setup screen (beyond_ui/fe.cpp) gets the
# recompiler, GCC and Python from inside the AppImage through SWR_RECOMPILER.
HERE="$(dirname "$(readlink -f "$0")")"
GAME="${METROID_BEYOND_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/MetroidBeyondRecomp}"
mkdir -p "$GAME" || { echo "Cannot create the game folder $GAME" >&2; exit 1; }
if ! cmp -s "$HERE/usr/bin/metroid-beyond" "$GAME/Metroid Prime 4 Beyond"; then
  cp -f "$HERE/usr/bin/metroid-beyond" "$GAME/Metroid Prime 4 Beyond.new" && chmod +x "$GAME/Metroid Prime 4 Beyond.new" && mv -f "$GAME/Metroid Prime 4 Beyond.new" "$GAME/Metroid Prime 4 Beyond"
fi
[ -d "$GAME/licenses" ] || cp -r "$HERE/usr/share/metroid-beyond/licenses" "$GAME/licenses" 2>/dev/null
export SWR_RECOMPILER="$HERE/usr/share/metroid-beyond/recompiler"
cd "$GAME" || exit 1
exec "./Metroid Prime 4 Beyond" "$@"
